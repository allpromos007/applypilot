# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Gemini platform configuration (default)
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# Observability (M4)
# Use Cloud DLP for PII redaction in logs (regex redaction is always on as a fallback).
# Requires: gcloud services enable dlp.googleapis.com
APPLYPILOT_USE_DLP=false
APPLYPILOT_LOG_LEVEL=INFO

# Guardrails (M5). Full Model Armor template resource name; leave empty to use
# only the local prompt-injection detector. Create one with:
#   gcloud model-armor templates create applypilot --location=us-central1 \
#     --rai-settings-filters='[{"filterType":"HATE_SPEECH","confidenceLevel":"MEDIUM_AND_ABOVE"},{"filterType":"HARASSMENT","confidenceLevel":"MEDIUM_AND_ABOVE"},{"filterType":"DANGEROUS","confidenceLevel":"MEDIUM_AND_ABOVE"},{"filterType":"SEXUALLY_EXPLICIT","confidenceLevel":"MEDIUM_AND_ABOVE"}]' \
#     --pi-and-jailbreak-filter-settings-enforcement=enabled \
#     --pi-and-jailbreak-filter-settings-confidence-level=medium-and-above \
#     --malicious-uri-filter-settings-enforcement=enabled
APPLYPILOT_MODEL_ARMOR_TEMPLATE=
# Context management (M5)
APPLYPILOT_CONTEXT_TOKEN_BUDGET=24000
APPLYPILOT_COMPACTION_INTERVAL=5

# Secrets (M6). Values come from Google Cloud Secret Manager; list secret IDs, never values.
#   Secret ID: mock-ats-api-key   (shared key the agent sends to the Mock ATS)
#   echo -n "$(openssl rand -hex 24)" | gcloud secrets create mock-ats-api-key --data-file=- --project l200capstone
# Local-dev fallback only (put the value in your git-ignored .env, never here):
# MOCK_ATS_API_KEY=
